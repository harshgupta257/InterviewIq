# Frontend configuration. Only PUBLIC values belong here: everything prefixed with
# VITE_ is bundled into the browser JavaScript. Never put API keys, the Supabase
# service-role key, or any backend secret in this file.

# FastAPI backend base URL (no trailing slash).
VITE_API_BASE_URL=http://localhost:8000

# Supabase project URL and public anon / publishable key (Project Settings > API).
# Leave both empty to run with demo login only (requires DEMO_MODE=true on the backend).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional public site details shown in the footer. Each item appears only when set.
# Social URLs must start with https://
VITE_CONTACT_EMAIL=
VITE_SOCIAL_GITHUB=
VITE_SOCIAL_LINKEDIN=
VITE_SOCIAL_X=
