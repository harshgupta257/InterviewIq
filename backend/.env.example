# ---------------------------------------------------------------------------
# InterviewIQ backend configuration. Copy to backend/.env and fill in.
# Never commit .env. Never put any of these values in frontend VITE_ variables.
# ---------------------------------------------------------------------------

# development | test | production
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated browser origins allowed by CORS (no trailing slash).
FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO

# --- Database ---------------------------------------------------------------
# Local/demo: SQLite file (tables auto-created).
DATABASE_URL=sqlite+aiosqlite:///./interviewiq.db
DB_AUTO_CREATE=true
# Production (Supabase > Project Settings > Database > Connection string, "Session pooler"):
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# DB_AUTO_CREATE=false   # schema comes from supabase/migrations

# --- Supabase Auth ------------------------------------------------------------
# Project URL (Project Settings > API). Used to verify user JWTs via the project's JWKS
# endpoint (asymmetric signing keys - recommended) and for account deletion.
SUPABASE_URL=
# Only needed if the project still signs tokens with the legacy HS256 shared secret
# (Project Settings > API > JWT Settings). Leave empty when using signing keys.
SUPABASE_JWT_SECRET=
# Service-role / secret key. Used ONLY server-side to delete a user's auth account when
# they delete their account. Optional; without it, deletion removes data and reports
# that the login must be removed by an administrator.
SUPABASE_SERVICE_ROLE_KEY=

# --- Demo mode ----------------------------------------------------------------
# Passwordless demo accounts seeded with labelled sample data. SQLite only.
DEMO_MODE=true
# At least 32 random characters, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
DEMO_JWT_SECRET=change-me-local-demo-secret-0123456789
# New demo accounts allowed per client IP per hour.
DEMO_SESSIONS_PER_HOUR=10

# --- AI provider --------------------------------------------------------------
# gemini | openai | demo   (demo = offline heuristic, NOT an AI model, clearly labelled in the UI)
AI_PROVIDER=demo
GEMINI_API_KEY=
OPENAI_API_KEY=
# Defaults: gemini-flash-latest / gpt-4o-mini
AI_MODEL=
# Tried in order when the primary model is overloaded (HTTP 503/429) or times out.
AI_FALLBACK_MODELS=
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
AI_RETRY_BACKOFF_SECONDS=1

# Per-user limit on AI-backed requests (session creation, evaluation, rewrite).
RATE_LIMIT_PER_MINUTE=10

# --- Job finder ---------------------------------------------------------------
# Live listings come from the Adzuna job-search API (free developer key:
# https://developer.adzuna.com). Leave empty to disable job search (the page explains it
# isn't configured; listings are never invented). Gemini's Google Search grounding is not
# used: its terms forbid analysing, caching or altering grounded results.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Two-letter Adzuna country code, e.g. in (India), gb, us, au, ca, de, sg.
ADZUNA_COUNTRY=in
# Identical searches by the same user within this window are served from storage.
JOB_SEARCH_CACHE_MINUTES=360
# Provider requests per search, and listings per request (Adzuna free tier: ~250 calls/day).
JOB_SEARCH_MAX_QUERIES=2
JOB_SEARCH_RESULTS_PER_QUERY=10
# Listings evaluated per search in one batched AI call.
JOB_SEARCH_MAX_MATCHED=12
# Uncached searches allowed per user per hour.
JOB_SEARCHES_PER_HOUR=10
RESUME_UPLOAD_MAX_MB=5
